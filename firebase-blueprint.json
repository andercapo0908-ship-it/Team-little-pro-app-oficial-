{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Informações de perfil do usuário (Personal ou Aluno)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "ID único do Firebase Auth" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "trainer", "student"] },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Student": {
      "title": "Student",
      "description": "Dados detalhados do aluno",
      "type": "object",
      "properties": {
        "trainerId": { "type": "string" },
        "age": { "type": "number" },
        "weight": { "type": "number" },
        "height": { "type": "number" },
        "goal": { "type": "string" },
        "groups": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      }
    },
    "Workout": {
      "title": "Workout",
      "description": "Ficha de treino personalizada",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "trainerId": { "type": "string" },
        "name": { "type": "string" },
        "division": { "type": "string", "description": "A, B, C, etc." },
        "duration": { "type": "string", "description": "Duração do treino em string, ex: 45 min" },
        "exercises": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "sets": { "type": "number" },
              "reps": { "type": "string" },
              "load": { "type": "string" },
              "rest": { "type": "string" },
              "muscleGroup": { "type": "string" },
              "videoUrl": { "type": "string" },
              "progress": { "type": "string", "enum": ["Não Iniciado", "Em Progresso", "Completo"] }
            }
          }
        }
      }
    },
    "AppSettings": {
      "title": "App Settings",
      "description": "Configurações globais do aplicativo",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string" },
        "globalAnnouncement": { "type": "string" },
        "coachNote": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "LibraryExercise": {
      "title": "Library Exercise",
      "description": "Exercício cadastrado na biblioteca global ou do personal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "muscleGroup": { "type": "string" },
        "equipment": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["Iniciante", "Intermediário", "Avançado"] },
        "videoUrl": { "type": "string" },
        "description": { "type": "string" },
        "trainerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Product": {
      "title": "Product",
      "description": "Produto da loja",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "promoPrice": { "type": "number" },
        "imageUrl": { "type": "string" },
        "sizes": { "type": "array", "items": { "type": "string" } },
        "colors": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" },
        "stock": { "type": "number" },
        "whatsappNumber": { "type": "string" },
        "pixKey": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "TransformationPost": {
      "title": "Transformation Post",
      "description": "Postagem de transformação (antes e depois)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "beforeUrl": { "type": "string" },
        "afterUrl": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "likes": { "type": "number" }
      }
    },
    "AppNotification": {
      "title": "Notification",
      "description": "Alertas e notificações para os alunos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "type": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "studentId", "title", "message", "read", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "Collection de perfis de usuário"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Dados complementares de alunos"
    },
    "/workouts/{workoutId}": {
      "schema": "Workout",
      "description": "Treinos dos alunos"
    },
    "/config/app": {
      "schema": "AppSettings",
      "description": "Configurações globais"
    },
    "/exercises/{exerciseId}": {
      "schema": "LibraryExercise",
      "description": "Biblioteca de exercícios"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Produtos da loja"
    },
    "/transformations/{transformationId}": {
      "schema": "TransformationPost",
      "description": "Galeria de transformações"
    },
    "/notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "Notificações dos atletas"
    }
  }
}
